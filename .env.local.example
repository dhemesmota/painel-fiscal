NEXT_PUBLIC_SUPABASE_URL=https://<seu-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<sua-anon-key>

# URL pública do app (usada nos links dos e-mails de lembrete)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Necessárias só para o cron de lembretes (app/api/cron/lembretes) —
# nunca prefixar com NEXT_PUBLIC_, são segredos de servidor.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-do-supabase>
RESEND_API_KEY=<sua-api-key-do-resend>
REMINDER_FROM_EMAIL=Painel Fiscal <onboarding@resend.dev>
CRON_SECRET=<gere-um-valor-aleatorio>

# Opcional: recebe um alerta por e-mail se o cron de lembretes falhar (erro
# de leitura no banco, falha ao enviar e-mail) ou se algum envio individual
# der erro. Sem isso configurado, uma falha silenciosa no cron passa
# despercebida — normalmente seu próprio e-mail.
ADMIN_ALERT_EMAIL=<seu-email-pessoal>

